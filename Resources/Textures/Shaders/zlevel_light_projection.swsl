light_mode unshaded;
blend_mode light_add;
preset raw;

const highp float FALLOFF_QUANTIZATION = 16.0;
const highp float CURVE_QUANTIZATION = 4095.0;
const highp float PARAMETER_BASE = 4096.0;

varying highp vec4 projectionData;

void vertex()
{
    projectionData = modulate;
    VERTEX = pixel_snap(apply_mvp(VERTEX));
}

void fragment()
{
    highp float packed = floor(UV2.y + 0.5);
    highp float falloffQuantized = floor(packed / PARAMETER_BASE);
    highp float falloff = falloffQuantized / FALLOFF_QUANTIZATION;
    highp float curveFactor = (packed - falloffQuantized * PARAMETER_BASE) / CURVE_QUANTIZATION;

    highp vec2 horizontal = (UV - vec2(0.5)) * 2.0;
    highp float s = clamp(sqrt(dot(horizontal, horizontal) + UV2.x), 0.0, 1.0);
    highp float s2 = s * s;
    highp float curve = mix(s, s2, clamp(curveFactor, 0.0, 1.0));
    highp float attenuation = clamp(
        ((1.0 - s2) * (1.0 - s2)) / (1.0 + falloff * curve),
        0.0,
        1.0);

    COLOR = vec4(
        projectionData.rgb,
        attenuation * projectionData.a * zTexture(UV).r);
}
