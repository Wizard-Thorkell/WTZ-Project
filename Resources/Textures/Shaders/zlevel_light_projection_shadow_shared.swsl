light_mode unshaded;
blend_mode light_add;
preset raw;

#include "/Shaders/Internal/shadow_cast_shared.swsl"

const highp float FALLOFF_QUANTIZATION = 16.0;
const highp float CURVE_QUANTIZATION = 4095.0;
const highp float PARAMETER_BASE = 4096.0;
const highp float g_MinVariance = 0.0;

varying highp vec4 projectionData;
varying highp vec2 worldPosition;

uniform highp vec2 lightCenter;
uniform highp float lightSoftness;
uniform highp float lightIndex;
uniform sampler2D shadowMap;

void vertex()
{
    projectionData = modulate;
    worldPosition = (modelMatrix * vec3(VERTEX, 1.0)).xy;
    VERTEX = pixel_snap(apply_mvp(VERTEX));
}

void fragment()
{
    highp float packedParameters = floor(UV2.y + 0.5);
    highp float falloffQuantized = floor(packedParameters / PARAMETER_BASE);
    highp float falloff = falloffQuantized / FALLOFF_QUANTIZATION;
    highp float curveFactor =
        (packedParameters - falloffQuantized * PARAMETER_BASE) / CURVE_QUANTIZATION;

    highp vec2 horizontal = (UV - vec2(0.5)) * 2.0;
    highp float s = clamp(sqrt(dot(horizontal, horizontal) + UV2.x), 0.0, 1.0);
    highp float s2 = s * s;
    highp float curve = mix(s, s2, clamp(curveFactor, 0.0, 1.0));
    highp float attenuation = clamp(
        ((1.0 - s2) * (1.0 - s2)) / (1.0 + falloff * curve),
        0.0,
        1.0);

    highp float occlusion = createOcclusion(worldPosition - lightCenter);
    if (occlusion == 0.0)
    {
        discard;
    }

    COLOR = vec4(
        projectionData.rgb,
        attenuation * projectionData.a * zTexture(UV).r * occlusion);
}
