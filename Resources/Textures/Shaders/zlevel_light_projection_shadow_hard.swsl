#include "/Textures/Shaders/zlevel_light_projection_shadow_shared.swsl"

highp float createOcclusion(highp vec2 diff)
{
    highp float distance = length(diff);
    highp vec2 occluderDistance = occludeDepth(diff, shadowMap, lightIndex);
    return smoothstep(0.1, 1.0, ChebyshevUpperBound(occluderDistance, distance));
}
